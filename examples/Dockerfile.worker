# Example: Using uentry for a Kubernetes worker/job

FROM alpine:3.23 AS builder
RUN set -eux; \
	arch="$(uname -m)"; \
	case "$arch" in \
		x86_64|amd64) release_arch="x86_64" ;; \
		aarch64|arm64) release_arch="aarch64" ;; \
		*) echo "Unsupported architecture: $arch" >&2; exit 1 ;; \
	esac; \
	apk add --no-cache ca-certificates; \
	wget -qO /tmp/uentry.apk "https://github.com/ysginc/uentry/releases/download/latest/uentry-${release_arch}-musl.apk"; \
	apk add --no-cache --allow-untrusted /tmp/uentry.apk; \
	rm -f /tmp/uentry.apk
WORKDIR /app
COPY your-worker /app/your-worker

FROM scratch
COPY --from=builder /usr/bin/uentry /uentry
COPY --from=builder /app/your-worker /app/your-worker
COPY --from=builder /etc/ssl/certs /etc/ssl/certs

# uentry config with strict mode
COPY config.yaml /etc/uentry/config.yaml

ENTRYPOINT ["/uentry", "--strict", "--profile", "worker"]
CMD ["/app/your-worker"]
