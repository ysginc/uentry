# Example: Using uentry as entrypoint for a web application
# Build uentry first: cargo build --release --target x86_64-unknown-linux-musl

FROM alpine:3.23 AS builder
RUN apk add --no-cache curl ca-certificates
WORKDIR /app
COPY --from=uentry-builder /uentry /uentry
COPY your-app /app/your-app

FROM scratch
COPY --from=builder /uentry /uentry
COPY --from=builder /app/your-app /app/your-app
COPY --from=builder /etc/ssl/certs /etc/ssl/certs

# uentry config
COPY config.yaml /etc/uentry/config.yaml

ENV PORT=8080
EXPOSE 8080

ENTRYPOINT ["/uentry", "--profile", "web"]
CMD ["/app/your-app"]
