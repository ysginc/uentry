FROM grafana/grafana:11.2.0
COPY uentry.secure.yaml /etc/uentry/config.yaml
RUN set -eux; \
	arch="$(uname -m)"; \
	case "$arch" in \
		x86_64|amd64) release_arch="x86_64" ;; \
		aarch64|arm64) release_arch="aarch64" ;; \
		*) echo "Unsupported architecture: $arch" >&2; exit 1 ;; \
	esac; \
	wget -qO /tmp/uentry.apk "https://github.com/ysginc/uentry/releases/download/latest/uentry-${release_arch}-musl.apk"; \
	apk add --no-cache --allow-untrusted /tmp/uentry.apk; \
	ln -sf "$(command -v uentry)" /uentry; \
	chmod +x /uentry; \
	mkdir -p /etc/uentry /tmp; \
	rm -f /tmp/uentry.apk
ENTRYPOINT ["/uentry", "--strict"]
CMD ["grafana", "server", "-v"]
