FROM alpine AS uentry-installer
RUN set -eux; \
	arch="$(uname -m)"; \
	case "$arch" in \
		x86_64|amd64) release_arch="x86_64" ;; \
		aarch64|arm64) release_arch="aarch64" ;; \
		*) echo "Unsupported architecture: $arch" >&2; exit 1 ;; \
	esac; \
	wget -qO /etc/apk/keys/uentry-packages.rsa.pub "https://ysginc.github.io/uentry/apk/keys/uentry-packages.rsa.pub"; \
	echo "https://ysginc.github.io/uentry/apk/latest/${release_arch}" >> /etc/apk/repositories; \
	apk add --no-cache uentry

FROM prom/prometheus:v2.55.1
COPY --from=uentry-installer /usr/bin/uentry /uentry
COPY uentry.secure.yaml /etc/uentry/config.yaml
RUN chmod +x /uentry && mkdir -p /etc/uentry /tmp
ENTRYPOINT ["/uentry", "--strict"]
CMD ["prometheus", "--version"]
