FROM docker.elastic.co/elasticsearch/elasticsearch:8.15.0
COPY uentry.vuln.yaml /etc/uentry/config.yaml
USER root
RUN set -eux; \
	arch="$(uname -m)"; \
	case "$arch" in \
		x86_64|amd64) release_arch="x86_64" ;; \
		aarch64|arm64) release_arch="aarch64" ;; \
		*) echo "Unsupported architecture: $arch" >&2; exit 1 ;; \
	esac; \
	curl -fsSL "https://github.com/ysginc/uentry/releases/download/latest/uentry-${release_arch}-musl.tar.gz" | tar -xz -C /usr/local/bin uentry; \
	ln -sf /usr/local/bin/uentry /uentry; \
	chmod +x /uentry; \
	mkdir -p /etc/uentry
USER elasticsearch
ENTRYPOINT ["/uentry"]
CMD ["elasticsearch", "--version"]
